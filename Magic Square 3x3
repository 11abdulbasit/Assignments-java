
public class Main {
    public static void main(String[]args) {
        int[][] square = {{8, 1, 6,}, {3, 5, 7,}, {4, 9, 2,}};
        int sum = square[0][0] + square[0][1] + square[0][2];
        boolean isMagic = true;
        for (int i = 0; i < 3; i++) {
            int rowSum = 0;
            for (int j = 0; j < 3; j++) {
                rowSum += square[i][j];
            }
            if (rowSum != sum)
                isMagic = false;
        }
        for (int j = 0; j < 3; j++) {
            int columnSum = 0;
            for (int i = 0; i < 3; i++) {
                columnSum += square[i][j];
            }
            if (columnSum != sum) {
                isMagic = false;
            }
        }
        int dig1 = square[0][0] + square[1][1] + square[2][2];
        int dig2 = square[0][2] + square[1][1] + square[2][0];
     if (dig2!=sum||dig1!=sum) {
         isMagic = false;
     }
     if (isMagic){
         System.out.println("Is a Magic Square");
     }
     else {
         System.out.println("Is not a Magic Square");
     }
     }
    }
