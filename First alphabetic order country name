public class Code {
    public static void main(String[] args) {
        String [] countryName =
                {"Pakistan", "India", "Afghanistan", "China", "France", "Japan", "Loandon", "Germany", "Dubai", "Suadia Arab"};
        System.out.println("Country name start with A is : ");
        for (int i = 0; i<countryName.length; i++){
            if (countryName[i].startsWith("A")) {
                System.out.println(countryName[i]);
            }
        }
    }
}



