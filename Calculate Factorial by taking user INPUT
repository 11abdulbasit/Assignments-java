import java.util.Scanner;
public class Main{
void main(String[] args) {
  Scanner sc = new Scanner(System.in);
  System.out.println("Enter number");
  long a = sc.nextLong();
  long factorial = 1;
  for (int i = 1 ; i<=a;i++){
    factorial = factorial * i;
  }
  System.out.println("Factorial of "+ a +" is " + factorial);
}
}
