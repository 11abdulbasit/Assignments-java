import java.util.Scanner;
public class Code {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String[] countryName = {"Pakistan", "India", "Afghanistan", "China", "France", "Japan", "Loandon", "Germany", "Dubai", "Suadia Arab"};

        System.out.println("Search country by name:");
        String a = sc.next();
        boolean found = false;
        for (int i = 0; i < countryName.length; i++)
        {
            if (a.equalsIgnoreCase(countryName[i]))
                found = true;
            break;
        }
        if (found) {
            System.out.println("COUNTRY EXIST IN ARRY");
        } else {

            System.out.println("COUNTRY not EXIST IN ARRAY");


        }
    }
}
